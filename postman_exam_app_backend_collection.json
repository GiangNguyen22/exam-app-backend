    {
      "name": "RBAC - Unauthorized (no token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/rbac/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rbac",
            "ping"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "const json = pm.response.json();",
              "pm.test('ApiResponse for 401', function () {",
              "  pm.expect(json.success).to.eql(false);",
              "  pm.expect(json.code).to.eql(401);",
              "  pm.expect(json.message).to.eql('Unauthorized');",
              "});"
            ]
          }
        }
      ]
    },
