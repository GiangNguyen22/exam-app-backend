# ========================================================
# Environment Variables for Secure Exam Application Backend
# ========================================================

# Profile
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/school_exam_db?connectionTimeZone=Asia%2FHo_Chi_Minh
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here
MYSQL_ROOT_PASSWORD=your_secure_db_password_here
MYSQL_DATABASE=school_exam_db

# JWT Configuration (Must be at least 32 characters for HMAC-SHA256)
JWT_SECRET=replace_this_with_a_secure_random_key_of_at_least_32_characters_long
JWT_EXPIRATION_MS=3600000

# Server Configuration
SERVER_ADDRESS=127.0.0.1
PORT=8080

# File Upload Configuration
APP_UPLOAD_DIR=uploads

# AI Integration (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Exam Config
EXAM_AUTO_SUBMIT_DELAY_MS=30000

# Exam Encryption Key (256-bit AES key in 64 hex characters or 32 raw bytes)
EXAM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Test User Seeding (Dev only)
SEED_TEST_USERS=true
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_TEACHER_PASSWORD=teacher123
DEFAULT_STUDENT_PASSWORD=student123
